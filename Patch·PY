#!/usr/bin/env python3
"""PixelForge fix patch.
Usage:  python3 patch.py index.html      (creates index.html.bak, then patches in place)
Fixes: CLS 0.278 (font swap), render-blocking Google Fonts, hash URLs -> real URLs,
per-page title/description/canonical, per-tool H1 + how-to + FAQ content."""
import sys, shutil

path = sys.argv[1] if len(sys.argv) > 1 else "index.html"
s = open(path, encoding="utf-8").read().replace("\r\n", "\n")
shutil.copy(path, path + ".bak")

def rep(old, new, count=None):
    global s
    n = s.count(old)
    if n == 0 or (count and n != count):
        sys.exit(f"STOP: expected {count or '>=1'} match(es), found {n} for:\n  {old[:90]}")
    s = s.replace(old, new)

# ---------- 1. FONT: non-blocking + no swap shift (fixes CLS + render-blocking) ----------
F = "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=optional"
rep('<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap">',
    f'<link rel="preload" as="style" href="{F}" onload="this.onload=null;this.rel=\'stylesheet\'">'
    f'<noscript><link rel="stylesheet" href="{F}"></noscript>', 1)
rep('"Barlow Condensed","Arial Narrow",system-ui', '"Barlow Condensed","Arial Narrow","sans-serif-condensed",system-ui')

# ---------- 2. Remove useless meta keywords ----------
import re
s, n = re.subn(r'<meta name="keywords"[^>]*>\n?', '', s)
if n != 1: sys.exit("STOP: meta keywords not found")

# ---------- 3. Real URLs instead of #hash ----------
PATHS = {"resize":"/resize-image","compress":"/compress-image","crop":"/crop-image","rotate":"/rotate-flip-image",
         "filters":"/image-filters","watermark":"/add-watermark-to-image","bg":"/remove-background",
         "convert":"/convert-image-format","base64":"/image-to-base64"}
for k, p in PATHS.items():
    rep(f'href="#{k}" data-t="{k}"', f'href="{p}" data-t="{k}"')
rep('href="#" ', 'href="/" ')
rep('href="#tools" ', 'href="/tools" ')

# ---------- 4. Info section (H1 + how-to + FAQ per tool) ----------
rep('<!-- ===== FOOTER ===== -->',
    '<section id="info" class="w hidden" style="max-width:860px;padding:40px 20px 56px"></section>\n<!-- ===== FOOTER ===== -->', 1)

