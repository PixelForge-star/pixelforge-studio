};
function metaSet(title,desc,path){document.title=title;$('meta[name=description]').content=desc;const u=location.origin+path;$('link[rel=canonical]').href=u;$('meta[property="og:url"]').content=u;$('meta[property="og:title"]').content=title;$('meta[property="og:description"]').content=desc}
function info(t){const d=T[t];$('#info').innerHTML='<h1 style="font-size:clamp(28px,4vw,40px)">'+d[0]+'</h1><p class="sub" style="margin-top:10px">'+d[2]+'</p><h2 style="font-size:26px;margin:24px 0 10px">How it works</h2><ol class="sub" style="padding-left:22px">'+d[3].map(x=>'<li>'+x+'</li>').join('')+'</ol><h2 style="font-size:26px;margin:24px 0 12px">Frequently asked questions</h2>'+d[4].map(f=>'<details><summary>'+f[0]+'</summary><p>'+f[1]+'</p></details>').join('')}
function goPath(t){const p=PATHS[t];if(location.pathname!=p)history.pushState(null,'',p);const d=T[t];metaSet(d[0]+' | PixelForge',d[1],p);info(t)}
function route(){const p=location.pathname.replace(/\/+$/,'')||'/',t=Object.keys(PATHS).find(k=>PATHS[k]==p);
  if(t){if(!$('#ed').classList.contains('hidden')&&orig)setTool(t);else{resetEd();showEd(t)}}
  else if(p=='/tools')show('tp');
  else{if(p!='/')history.replaceState(null,'','/');show('home')}}
addEventListener('popstate',route);

"""
rep('/* ===== NAVIGATION ===== */', BLOCK + '/* ===== NAVIGATION ===== */', 1)

# show(): real URLs + meta + info toggle
rep("function show(id){['home','tp','ed'].forEach(p=>$('#'+p).classList.toggle('hidden',p!=id));document.title=TT[id];scrollTo(0,0)}",
    "function show(id){['home','tp','ed'].forEach(p=>$('#'+p).classList.toggle('hidden',p!=id));$('#info').classList.toggle('hidden',id!='ed');"
    "if(id!='ed'){const p=HP[id];if(location.pathname!=p)history.pushState(null,'',p);metaSet(TT[id],id=='home'?HOME_D:TOOLS_D,p)}scrollTo(0,0)}", 1)
# setTool(): replace hash with real path
rep("history.replaceState(null,'','#'+t);", "goPath(t);", 1)
# boot
rep("resetEd();\n</script>", "resetEd();route();\n</script>", 1)

open(path, "w", encoding="utf-8").write(s)
print("OK – patched", path, "(backup:", path + ".bak)")
